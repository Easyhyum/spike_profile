# spike_tests_vi/config.env — CURRENT + VOLTAGE campaign (CH1 = current probe, CH2 = 12 V). Scripts are symlinks to ../spike_tests;
# only this file, logs/ and results/ are separate, so both campaigns run with plain `sudo ./run_all.sh` and no options.
# hardware / channel configuration. Sourced by every script; every value can be overridden
# from the environment:   sudo env CYCLES=3 ./run_all.sh 01
#
# Workload: NOT configured here. 00_preflight.sh runs find_max_shape.py, which probes dtype x size on the attached GPU
# and writes logs/auto_shape.env (AUTO_DTYPE, AUTO_SIZE, AUTO_DURATION_ROWS, AUTO_SMS ...). Set DTYPE / SIZE below only to pin
# a shape by hand. Every test runs SINGLE CYCLES (one GEMM launch per measurement) of that shape unless stated otherwise.

# ---- measurement repetitions
: "${CYCLES:=10}"          # single cycles per test (01 baseline, 02 duration); 03 clock uses CLOCK_CYCLES, 04 wave uses WAVE_CYCLES
: "${CLOCK_CYCLES:=2}"
: "${WAVE_CYCLES:=3}"
: "${OFF_MS:=1000}"        # idle between cycles (>= 1000 ms so the scope can fetch two channels and re-arm)
: "${DTYPE:=}"             # empty = AUTO_DTYPE from logs/auto_shape.env
: "${SIZE:=}"              # empty = AUTO_SIZE (M=N=K)

# ---- oscilloscope channel assignment
: "${SCOPE_METER:=2}"      # 1 = Keysight DSOX1202A (USB), 2 = LeCroy HDO4034A (USB or SCOPE_RESOURCE=TCPIP::ip::INSTR)
: "${SCOPE_RESOURCE:=}"    # empty = first USB device of the vendor; LAN: TCPIP::<scope ip>::INSTR (HDO: Utilities > Remote = VXI11/LXI)
#   HDO4034A + CP500 PRESET -> SCOPE_METER=2  SCOPE_BUSID=<usbipd id of the HDO, or empty for LAN>  I_SCALE=1 (ProBus probe: the scope
#   already reads amperes)  V_DIV=0.5 (12-bit; the driver steps to 1 V/div by itself if the 12 V offset needs it)  I_DIV=12  I_CENTER=45
: "${V_CH:=2}"             # CH2 = PSU 12 V cable (CH1 = CP500 current, CH4 = PCIe slot 12 V)
: "${V2_CH:=4}"            # CH4 = PCIe slot 12 V (second voltage channel)
: "${V_NAME:=PSU 12V cable}"      # name used in figure legends / tables
: "${V2_NAME:=PCIe slot 12V}"
: "${REQUIRE_I:=1}"        # this campaign needs the current probe: tests skip (not fall back to voltage-only) when CH1 is not live
: "${I_CH:=1}"             # CH1 = current probe (1 .. 90 A). Every test records V x I (P = V x I per 1 us sample) and triggers on the current rise.
#   CURRENT-PROBE MODE (CH1 = current 1..90 A, CH2 = voltage) -> set:  V_CH=2  V2_CH=  I_CH=1  I_SCALE=<A per V of the probe>
#   I_DIV=12  I_CENTER=45  (8 div x 12 A = 96 A on screen, -3 .. +93 A)  TRIG_I_LEVEL=3  -> results carry V, I and P = V x I.
: "${V_PROBE:=1}"          # voltage probe attenuation (1 or 10)
: "${V_DIV:=0.5}"          # V/div (0.5 keeps 12 V on screen with a 1:1 probe)
: "${V_CENTER:=12.0}"
: "${I_SCALE:=1}"          # ProBus CP500: the HDO already reads amperes (set from the probe for a BNC clamp: 100 mV/A -> 10)
: "${I_OFFSET:=0.0}"       # A to subtract (probe zero error)
: "${I_DIV:=12}"           # A/div   (12 A/div with I_CENTER=45 covers 1..90 A)
: "${I_CENTER:=45}"        # A at screen centre

# ---- scope sample spacing (ns). 1000 = 1 us (DSOX max rate for long records). HDO4034A: 1-2-5 steps, e.g. 100 (10 MSa/s), 40, 20 (50 MSa/s,
#      the most a 200 ms record allows in 12.5 Mpts); longer records lower the rate automatically. csv stays at >= 1 us, npz keeps the full rate.
: "${SCOPE_SAMPLE_NS:=1000}"
# ---- trigger (edge trigger + software force fallback; plots align on the voltage onset)
: "${TRIG_V_LEVEL:=auto:0.15}" # falling edge on the voltage channel: auto = idle - 0.15 V, or a fixed V
: "${TRIG_I_LEVEL:=3.0}"   # A, rising edge on the current channel (V x I tests)

# ---- usbipd bus ids (usbipd list on Windows); the runner re-attaches both before every scope test
: "${SCOPE_BUSID:=6-3}"
: "${PMD_BUSID:=6-4}"

# ---- board power limit for the whole sequence (nvidia-smi -pl through clockctl.py's elevated Windows server = one UAC
#      prompt at the start of run_all.sh; restored to the default limit at the end and whenever the server exits)
: "${POWER_LIMIT_W:=}"     # empty = leave the GPU's default limit (180 W on the 5060 Ti); 200 = its max limit.  sudo env POWER_LIMIT_W=200 ./run_all.sh
# ---- warm clock (LeCroy stop-capture only): one GEMM of the same shape ends PREWARM_GAP_MS before every measured launch, so the
#      kernel runs at the settled clock (~2750 MHz) from t = 0 instead of 30 ms at ~2640 MHz; the current is back at idle in < 1 ms
: "${PREWARM_GAP_MS:=}"    # empty = off; 20 = recommended (<= 20 ms keeps the warm state, >= 50 ms loses it).  sudo env PREWARM_GAP_MS=20 ./run_all.sh
: "${PREWARM_MS:=}"        # minimum warm-up load before the gap (ms; empty = one launch). all-SM mode (GPU idles in P8 between cycles) needs ~200+
# ---- in-kernel clock monitor
: "${FREQMON:=1}"          # 1 = freqmon holds one SM (10 us SM clock in every figure); 0 = no monitor, ALL SMs run the GEMM
                           #     (wave targets use every SM; clocks then come from nvidia-smi only). sudo env FREQMON=0 ./run_all.sh
# ---- misc
: "${ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"   # the matmul_test root (spike_eval.py, onset.py, *.cu live there)
: "${PY:=$ROOT/venv/bin/python}"
: "${SMI_MS:=100}"
